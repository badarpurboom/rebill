# Copy this file to .deploy/vps.local.env and fill in local values.
# Keep secrets out of this file. Use your local SSH key/agent.

VPS_SSH_TARGET=root@example.com
VPS_SSH_PORT=22
VPS_APP_DIR=/var/www/rebill
VPS_BRANCH=main
VPS_BACKEND_SERVICE=rebill-backend
VPS_PUBLIC_URL=http://example.com/
VPS_HEALTH_URL=http://127.0.0.1/api/health/
